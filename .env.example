# 复制为 .env 后按需修改；docker compose 会自动读取同目录的 .env
# 注意：.env 含密钥时不要提交到仓库（已在 .gitignore 中忽略）

# ---- 镜像与端口 ----
# 留空则使用本地构建（docker compose up --build）
IMAGE=
PORT=8080
VERSION=dev

# ---- 实例 TTL ----
DEFAULT_TTL=30m
MAX_TTL=6h
MAX_INSTANCES=64
SWEEP_INTERVAL=5s
GRACE_PERIOD=10m

# ---- 抓取 ----
HTTP_TIMEOUT=30s
CACHE_TTL=1h

# ---- 安全（生产必填）----
# 生成：openssl rand -hex 32
API_TOKEN=
RATE_LIMIT=0

# ---- 日志与停机 ----
QUIET=1
VERBOSE_JS=0
SHUTDOWN_TIMEOUT=10s
